{
  "name": "nexusclaw-community",
  "version": "0.1.0-community",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/dashboard"
  ],
  "scripts": {
    "build": "npm run build -w @nexusclaw/shared && npm run build -w @nexusclaw/backend && npm run build -w @nexusclaw/dashboard",
    "start": "npm run start -w @nexusclaw/backend",
    "dev:dashboard": "npm run dev -w @nexusclaw/dashboard",
    "check:i18n": "npm run build -w @nexusclaw/shared && node scripts/check-locale-parity.mjs",
    "check:dify": "node scripts/check-dify-schema.mjs"
  },
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=11.6.0 <12"
  },
  "overrides": {
    "@isaacs/cliui": {
      "string-width": {
        ".": "7.2.0",
        "get-east-asian-width": "1.4.0"
      }
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "js-yaml": "^4.1.0"
  }
}
