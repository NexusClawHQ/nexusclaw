# @nestjs/apollo 13.x pins @apollo/server-plugin-landing-page-graphql-playground@4.0.1,
# whose peer range (@apollo/server ^4.0.0) lags behind the @apollo/server ^5 line that
# @nestjs/apollo itself requires. Until the plugin publishes a 5.x-compatible peer range,
# peer conflicts are resolved the same way the original lockfile was produced.
legacy-peer-deps=true
